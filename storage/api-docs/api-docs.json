{
    "openapi": "3.0.0",
    "info": {
        "title": "TuTramiteFacil API",
        "description": "API REST para gestión de solicitantes y solicitudes de ayudas sociales (DDD + Clean Architecture).",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8010",
            "description": "Servidor local de desarrollo"
        }
    ],
    "paths": {
        "/api/auth/register": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Registrar un nuevo usuario",
                "operationId": "bcf74df7bb7d038225880aee509dfebc",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "Carlos"
                                    },
                                    "email": {
                                        "type": "string",
                                        "example": "carlos@test.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "example": "password123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Usuario creado, devuelve access_token"
                    }
                }
            }
        },
        "/api/auth/login": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Iniciar sesión y obtener token JWT",
                "operationId": "ce6088c43b35a3008d6daa5475812c9f",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "example": "carlos@test.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "example": "password123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Login correcto, devuelve access_token"
                    },
                    "401": {
                        "description": "Credenciales inválidas"
                    }
                }
            }
        },
        "/api/auth/logout": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Cerrar sesión (invalida el token actual)",
                "operationId": "176013de7f989f3658907372c4d7c8ea",
                "responses": {
                    "200": {
                        "description": "Sesión cerrada correctamente"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/auth/me": {
            "get": {
                "tags": [
                    "Auth"
                ],
                "summary": "Obtener el usuario autenticado",
                "operationId": "cf09cdc2ad8af937c13d88187eed2c62",
                "responses": {
                    "200": {
                        "description": "Datos del usuario autenticado"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/solicitantes": {
            "get": {
                "tags": [
                    "Solicitantes"
                ],
                "summary": "Listar todos los solicitantes",
                "operationId": "313d91180355d1417ae35759a4ed1711",
                "responses": {
                    "200": {
                        "description": "Listado de solicitantes"
                    }
                }
            },
            "post": {
                "tags": [
                    "Solicitantes"
                ],
                "summary": "Crear un nuevo solicitante",
                "operationId": "765cc3a5cf6beda0ab59a4a62a8214e4",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "nombre",
                                    "apellidos",
                                    "email",
                                    "telefono",
                                    "comunidad_autonoma",
                                    "fecha_registro"
                                ],
                                "properties": {
                                    "nombre": {
                                        "type": "string",
                                        "example": "Carlos"
                                    },
                                    "apellidos": {
                                        "type": "string",
                                        "example": "Macero"
                                    },
                                    "email": {
                                        "type": "string",
                                        "example": "carlos@example.com"
                                    },
                                    "telefono": {
                                        "type": "string",
                                        "example": "600000000"
                                    },
                                    "comunidad_autonoma": {
                                        "type": "string",
                                        "example": "Comunidad Valenciana"
                                    },
                                    "fecha_registro": {
                                        "type": "string",
                                        "format": "date",
                                        "example": "2026-06-15"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Solicitante creado"
                    },
                    "401": {
                        "description": "No autenticado"
                    },
                    "422": {
                        "description": "Error de validación"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/solicitantes/{solicitante}": {
            "get": {
                "tags": [
                    "Solicitantes"
                ],
                "summary": "Obtener un solicitante por su UUID",
                "operationId": "40dd1d9b0efaf7c641679f6b92408958",
                "parameters": [
                    {
                        "name": "solicitante",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Solicitante encontrado"
                    },
                    "404": {
                        "description": "No encontrado"
                    }
                }
            },
            "put": {
                "tags": [
                    "Solicitantes"
                ],
                "summary": "Actualizar un solicitante existente",
                "operationId": "d7a77d14947c526d085cf5314e87fe18",
                "parameters": [
                    {
                        "name": "solicitante",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Solicitante actualizado"
                    },
                    "401": {
                        "description": "No autenticado"
                    },
                    "404": {
                        "description": "No encontrado"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "delete": {
                "tags": [
                    "Solicitantes"
                ],
                "summary": "Eliminar un solicitante",
                "operationId": "6f19539874ca2eef321b36ecaf7f15c2",
                "parameters": [
                    {
                        "name": "solicitante",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Eliminado correctamente"
                    },
                    "401": {
                        "description": "No autenticado"
                    },
                    "404": {
                        "description": "No encontrado"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/solicitudes": {
            "get": {
                "tags": [
                    "Solicitudes"
                ],
                "summary": "Listar todas las solicitudes",
                "operationId": "af2fa1a2817177309b1fff464a0c6b27",
                "responses": {
                    "200": {
                        "description": "Listado de solicitudes"
                    }
                }
            },
            "post": {
                "tags": [
                    "Solicitudes"
                ],
                "summary": "Crear una nueva solicitud (encola Job de procesamiento)",
                "operationId": "f322569936bf9baef1864569414a2395",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "solicitante_id",
                                    "tipo_ayuda",
                                    "fecha_solicitud",
                                    "importe_estimado"
                                ],
                                "properties": {
                                    "solicitante_id": {
                                        "type": "string",
                                        "format": "uuid"
                                    },
                                    "tipo_ayuda": {
                                        "type": "string",
                                        "enum": [
                                            "Alquiler",
                                            "ChequeBebe",
                                            "IngresoMinimoVital",
                                            "BonoCulturalJoven"
                                        ]
                                    },
                                    "fecha_solicitud": {
                                        "type": "string",
                                        "format": "date",
                                        "example": "2026-06-15"
                                    },
                                    "fecha_resolucion": {
                                        "type": "string",
                                        "format": "date",
                                        "nullable": true
                                    },
                                    "importe_estimado": {
                                        "type": "number",
                                        "format": "float",
                                        "example": 1200.5
                                    },
                                    "estado": {
                                        "type": "string",
                                        "enum": [
                                            "Pendiente",
                                            "EnRevision",
                                            "Concedida",
                                            "Denegada"
                                        ]
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Solicitud creada"
                    },
                    "401": {
                        "description": "No autenticado"
                    },
                    "422": {
                        "description": "Error de validación"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/solicitudes/{solicitud}": {
            "get": {
                "tags": [
                    "Solicitudes"
                ],
                "summary": "Obtener una solicitud por su UUID",
                "operationId": "93ac7390bbeb5dcebfac87026a2527c6",
                "parameters": [
                    {
                        "name": "solicitud",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Solicitud encontrada"
                    },
                    "404": {
                        "description": "No encontrada"
                    }
                }
            },
            "put": {
                "tags": [
                    "Solicitudes"
                ],
                "summary": "Actualizar una solicitud (encola Job si cambia el estado)",
                "operationId": "2546a9f29f26e7e6b22138da3775ffb2",
                "parameters": [
                    {
                        "name": "solicitud",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Solicitud actualizada"
                    },
                    "401": {
                        "description": "No autenticado"
                    },
                    "404": {
                        "description": "No encontrada"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "delete": {
                "tags": [
                    "Solicitudes"
                ],
                "summary": "Eliminar una solicitud",
                "operationId": "428f2a256038f899e6864069bf9f029d",
                "parameters": [
                    {
                        "name": "solicitud",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Eliminada correctamente"
                    },
                    "401": {
                        "description": "No autenticado"
                    },
                    "404": {
                        "description": "No encontrada"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        }
    },
    "components": {
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "bearerFormat": "JWT",
                "scheme": "bearer"
            }
        }
    },
    "tags": [
        {
            "name": "Auth",
            "description": "Registro, login y gestión de sesión vía JWT"
        },
        {
            "name": "Solicitantes",
            "description": "Gestión de solicitantes de ayudas sociales"
        },
        {
            "name": "Solicitudes",
            "description": "Gestión de solicitudes de ayudas sociales"
        }
    ]
}