{
    "openapi": "3.0.0",
    "info": {
        "title": "TuTramiteFacil API",
        "description": "API REST para gestión de solicitantes y solicitudes de ayudas sociales (DDD + Clean Architecture).",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8010",
            "description": "Servidor local de desarrollo"
        }
    ],
    "paths": {
        "/api/auth/register": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Registrar un nuevo usuario",
                "description": "POST /api/auth/register\nCrea un usuario y devuelve su token JWT.",
                "operationId": "bcf74df7bb7d038225880aee509dfebc",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "Carlos Macero"
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "carlos@example.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "example": "secret123",
                                        "minLength": 6
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Usuario creado; devuelve access_token y datos del usuario"
                    },
                    "422": {
                        "description": "Error de validación"
                    }
                }
            }
        },
        "/api/auth/login": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Iniciar sesión",
                "description": "POST /api/auth/login\nVerifica credenciales y devuelve un token JWT.",
                "operationId": "ce6088c43b35a3008d6daa5475812c9f",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "demo@tutramitefacil.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "example": "demo1234"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Login exitoso; devuelve access_token"
                    },
                    "401": {
                        "description": "Credenciales inválidas"
                    }
                }
            }
        },
        "/api/auth/logout": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Cerrar sesión (invalida el token JWT)",
                "description": "POST /api/auth/logout\nInvalida el token actual.",
                "operationId": "176013de7f989f3658907372c4d7c8ea",
                "responses": {
                    "200": {
                        "description": "Sesión cerrada correctamente"
                    },
                    "401": {
                        "description": "No autenticado"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/auth/me": {
            "get": {
                "tags": [
                    "Auth"
                ],
                "summary": "Obtener datos del usuario autenticado",
                "description": "GET /api/auth/me\nDevuelve el usuario autenticado (útil para el frontend).",
                "operationId": "cf09cdc2ad8af937c13d88187eed2c62",
                "responses": {
                    "200": {
                        "description": "Datos del usuario autenticado"
                    },
                    "401": {
                        "description": "No autenticado"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/solicitantes": {
            "get": {
                "tags": [
                    "Solicitantes"
                ],
                "summary": "Listar todos los solicitantes",
                "description": "GET /api/solicitantes\nPúblico (sin autenticación), según el enunciado.",
                "operationId": "313d91180355d1417ae35759a4ed1711",
                "responses": {
                    "200": {
                        "description": "Lista de solicitantes"
                    }
                }
            },
            "post": {
                "tags": [
                    "Solicitantes"
                ],
                "summary": "Crear un nuevo solicitante",
                "description": "POST /api/solicitantes\nRequiere JWT (se configurará en las rutas).",
                "operationId": "765cc3a5cf6beda0ab59a4a62a8214e4",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "nombre",
                                    "apellidos",
                                    "email",
                                    "telefono",
                                    "comunidad_autonoma",
                                    "fecha_registro"
                                ],
                                "properties": {
                                    "nombre": {
                                        "type": "string",
                                        "example": "Carlos"
                                    },
                                    "apellidos": {
                                        "type": "string",
                                        "example": "Macero Delgado"
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "carlos@example.com"
                                    },
                                    "telefono": {
                                        "type": "string",
                                        "example": "600000000"
                                    },
                                    "comunidad_autonoma": {
                                        "type": "string",
                                        "example": "Comunidad Valenciana"
                                    },
                                    "fecha_registro": {
                                        "type": "string",
                                        "format": "date",
                                        "example": "2026-06-15"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Solicitante creado"
                    },
                    "401": {
                        "description": "No autenticado"
                    },
                    "422": {
                        "description": "Error de validación"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/solicitantes/{solicitante}": {
            "get": {
                "tags": [
                    "Solicitantes"
                ],
                "summary": "Ver detalle de un solicitante",
                "description": "GET /api/solicitantes/{solicitante}\nPúblico.",
                "operationId": "40dd1d9b0efaf7c641679f6b92408958",
                "parameters": [
                    {
                        "name": "solicitante",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Datos del solicitante"
                    },
                    "404": {
                        "description": "No encontrado"
                    }
                }
            },
            "put": {
                "tags": [
                    "Solicitantes"
                ],
                "summary": "Actualizar un solicitante",
                "description": "PUT /api/solicitantes/{solicitante}\nRequiere JWT.",
                "operationId": "d7a77d14947c526d085cf5314e87fe18",
                "parameters": [
                    {
                        "name": "solicitante",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "nombre": {
                                        "type": "string",
                                        "example": "Carlos"
                                    },
                                    "apellidos": {
                                        "type": "string",
                                        "example": "Macero Delgado"
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "carlos@example.com"
                                    },
                                    "telefono": {
                                        "type": "string",
                                        "example": "600000000"
                                    },
                                    "comunidad_autonoma": {
                                        "type": "string",
                                        "example": "Madrid"
                                    },
                                    "fecha_registro": {
                                        "type": "string",
                                        "format": "date",
                                        "example": "2026-06-15"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Solicitante actualizado"
                    },
                    "401": {
                        "description": "No autenticado"
                    },
                    "404": {
                        "description": "No encontrado"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "delete": {
                "tags": [
                    "Solicitantes"
                ],
                "summary": "Eliminar un solicitante",
                "description": "DELETE /api/solicitantes/{solicitante}\nRequiere JWT.",
                "operationId": "6f19539874ca2eef321b36ecaf7f15c2",
                "parameters": [
                    {
                        "name": "solicitante",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Eliminado correctamente"
                    },
                    "401": {
                        "description": "No autenticado"
                    },
                    "404": {
                        "description": "No encontrado"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/solicitudes": {
            "get": {
                "tags": [
                    "Solicitudes"
                ],
                "summary": "Listar todas las solicitudes",
                "description": "GET /api/solicitudes — público.",
                "operationId": "af2fa1a2817177309b1fff464a0c6b27",
                "responses": {
                    "200": {
                        "description": "Lista de solicitudes"
                    }
                }
            },
            "post": {
                "tags": [
                    "Solicitudes"
                ],
                "summary": "Crear una nueva solicitud",
                "description": "Al crear la solicitud se encola ProcesarSolicitudJob en Horizon para procesamiento asíncrono.",
                "operationId": "f322569936bf9baef1864569414a2395",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "solicitante_id",
                                    "tipo_ayuda",
                                    "fecha_solicitud",
                                    "importe_estimado"
                                ],
                                "properties": {
                                    "solicitante_id": {
                                        "type": "string",
                                        "format": "uuid",
                                        "example": "uuid-del-solicitante"
                                    },
                                    "tipo_ayuda": {
                                        "type": "string",
                                        "example": "Alquiler",
                                        "enum": [
                                            "Alquiler",
                                            "ChequeBebe",
                                            "IngresoMinimoVital",
                                            "BonoCulturalJoven"
                                        ]
                                    },
                                    "fecha_solicitud": {
                                        "type": "string",
                                        "format": "date",
                                        "example": "2026-06-15"
                                    },
                                    "fecha_resolucion": {
                                        "type": "string",
                                        "format": "date",
                                        "example": null,
                                        "nullable": true
                                    },
                                    "importe_estimado": {
                                        "type": "number",
                                        "format": "float",
                                        "example": 500
                                    },
                                    "estado": {
                                        "type": "string",
                                        "example": "Pendiente",
                                        "enum": [
                                            "Pendiente",
                                            "EnRevision",
                                            "Concedida",
                                            "Denegada"
                                        ]
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Solicitud creada"
                    },
                    "401": {
                        "description": "No autenticado"
                    },
                    "422": {
                        "description": "Error de validación"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/solicitudes/{solicitud}": {
            "get": {
                "tags": [
                    "Solicitudes"
                ],
                "summary": "Ver detalle de una solicitud",
                "description": "GET /api/solicitudes/{solicitud} — público.",
                "operationId": "93ac7390bbeb5dcebfac87026a2527c6",
                "parameters": [
                    {
                        "name": "solicitud",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Datos de la solicitud"
                    },
                    "404": {
                        "description": "No encontrada"
                    }
                }
            },
            "put": {
                "tags": [
                    "Solicitudes"
                ],
                "summary": "Actualizar una solicitud",
                "description": "Si el campo estado cambia, se encola ProcesarSolicitudJob para notificar el nuevo estado.",
                "operationId": "2546a9f29f26e7e6b22138da3775ffb2",
                "parameters": [
                    {
                        "name": "solicitud",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "solicitante_id": {
                                        "type": "string",
                                        "format": "uuid"
                                    },
                                    "tipo_ayuda": {
                                        "type": "string",
                                        "enum": [
                                            "Alquiler",
                                            "ChequeBebe",
                                            "IngresoMinimoVital",
                                            "BonoCulturalJoven"
                                        ]
                                    },
                                    "fecha_solicitud": {
                                        "type": "string",
                                        "format": "date"
                                    },
                                    "fecha_resolucion": {
                                        "type": "string",
                                        "format": "date",
                                        "nullable": true
                                    },
                                    "importe_estimado": {
                                        "type": "number",
                                        "format": "float"
                                    },
                                    "estado": {
                                        "type": "string",
                                        "enum": [
                                            "Pendiente",
                                            "EnRevision",
                                            "Concedida",
                                            "Denegada"
                                        ]
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Solicitud actualizada"
                    },
                    "401": {
                        "description": "No autenticado"
                    },
                    "404": {
                        "description": "No encontrada"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "delete": {
                "tags": [
                    "Solicitudes"
                ],
                "summary": "Eliminar una solicitud",
                "description": "DELETE /api/solicitudes/{solicitud} — requiere JWT.",
                "operationId": "428f2a256038f899e6864069bf9f029d",
                "parameters": [
                    {
                        "name": "solicitud",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Eliminada correctamente"
                    },
                    "401": {
                        "description": "No autenticado"
                    },
                    "404": {
                        "description": "No encontrada"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        }
    },
    "components": {
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "bearerFormat": "JWT",
                "scheme": "bearer"
            }
        }
    },
    "tags": [
        {
            "name": "Auth",
            "description": "Auth"
        },
        {
            "name": "Solicitantes",
